{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "black", "color": "#000000", "name": "Black" },
				{ "slug": "white", "color": "#ffffff", "name": "White" },
				{ "slug": "brown", "color": "#3a261f", "name": "Brown" },
				{ "slug": "accent", "color": "#c7f2e1", "name": "Turquoise" },
				{ "slug": "accent-strong", "color": "#9ee5c9", "name": "Turquoise Strong" },
				{ "slug": "primary", "color": "#000000", "name": "Primary" },
				{ "slug": "secondary", "color": "#3a261f", "name": "Secondary" },
				{ "slug": "background", "color": "#ffffff", "name": "Background" },
				{ "slug": "surface", "color": "#f5f5f5", "name": "Surface" },
				{ "slug": "text", "color": "#000000", "name": "Text" },
				{ "slug": "text-muted", "color": "#5c5c62", "name": "Text Muted" },
				{ "slug": "hairline", "color": "#e0e0e8", "name": "Hairline" }
			],
			"gradients": [
				{
					"slug": "brand",
					"gradient": "linear-gradient(135deg, #3a261f 0%, #2a1a15 100%)",
					"name": "Brand"
				},
				{
					"slug": "accent",
					"gradient": "linear-gradient(160deg, rgba(199, 242, 225, 0.28) 0%, #ffffff 55%, rgba(199, 242, 225, 0.12) 100%)",
					"name": "Accent"
				},
				{
					"slug": "hero",
					"gradient": "linear-gradient(165deg, #f5f5f5 0%, #ffffff 48%, rgba(199, 242, 225, 0.28) 100%)",
					"name": "Hero"
				},
				{
					"slug": "backdrop",
					"gradient": "linear-gradient(180deg, #3a261f 0%, #2a1a15 100%)",
					"name": "Backdrop"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "\"Oswald\", \"Arial Narrow\", sans-serif",
					"name": "Display",
					"slug": "display"
				},
				{
					"fontFamily": "\"Montserrat\", \"Helvetica Neue\", Helvetica, sans-serif",
					"name": "UI",
					"slug": "ui"
				},
				{
					"fontFamily": "\"Source Sans 3\", \"Helvetica Neue\", Helvetica, sans-serif",
					"name": "Body",
					"slug": "body"
				}
			],
			"fontSizes": [
				{ "slug": "micro", "size": "0.75rem", "name": "Micro" },
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "medium", "size": "1rem", "name": "Medium" },
				{ "slug": "large", "size": "1.25rem", "name": "Large" },
				{ "slug": "x-large", "size": "1.5rem", "name": "Extra Large" },
				{ "slug": "xx-large", "size": "2.25rem", "name": "2X Large" },
				{ "slug": "display", "size": "clamp(2.5rem, 7vw, 5rem)", "name": "Display" }
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "xxs", "size": "0.25rem", "name": "XXS" },
				{ "slug": "xs", "size": "0.5rem", "name": "XS" },
				{ "slug": "sm", "size": "0.75rem", "name": "SM" },
				{ "slug": "md", "size": "1rem", "name": "MD" },
				{ "slug": "lg", "size": "1.125rem", "name": "LG" },
				{ "slug": "xl", "size": "1.5rem", "name": "XL" },
				{ "slug": "xxl", "size": "2rem", "name": "XXL" },
				{ "slug": "huge", "size": "3rem", "name": "Huge" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.1",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--black)"
				},
				"border": {
					"color": "var(--wp--preset--color--accent)",
					"width": "1px",
					"style": "solid",
					"radius": "0"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.12em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--brown)"
				}
			}
		}
	}
}
